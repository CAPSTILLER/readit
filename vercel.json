{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/google-tts.js": { "maxDuration": 60 },
    "api/download.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
